{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FichaCSIRC",
  "version": "4.0.0-alpha.1",
  "identifier": "es.ugr.csirc.fichacsirc",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "principal",
        "title": "FichaCSIRC (Rust, en pruebas)",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
