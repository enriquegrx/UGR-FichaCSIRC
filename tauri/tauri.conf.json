{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FichaCSIRC",
  "version": "4.0.0-rc.3",
  "identifier": "es.ugr.csirc.fichacsirc",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsh",
        "languages": ["Spanish"]
      }
    }
  }
}
